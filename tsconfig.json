{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler"
	},
	"include": ["src", "test", "*", "e2e"],
	"exclude": ["src/service-worker"]
}
